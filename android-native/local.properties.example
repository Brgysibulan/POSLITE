# Copy this file to local.properties. Never commit real credentials.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# X.509 SubjectPublicKeyInfo DER, base64 encoded. The matching private key is
# stored only as the LICENSE_PRIVATE_KEY secret in Supabase Edge Functions.
SARIPOS_LICENSE_PUBLIC_KEY=

